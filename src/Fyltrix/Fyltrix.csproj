<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK projection: used for the built-in PDF renderer (Windows.Data.Pdf). -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>Fyltrix</RootNamespace>
    <AssemblyName>Fyltrix</AssemblyName>
    <StartupObject>Fyltrix.App</StartupObject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Logo (generated by tools/LogoGen): exe icon, which Explorer, the taskbar and Alt+Tab use. -->
    <ApplicationIcon>Assets\Fyltrix.ico</ApplicationIcon>

    <Company>Fyltrix</Company>
    <Product>Fyltrix</Product>
    <Title>Fyltrix</Title>
    <AssemblyTitle>Fyltrix</AssemblyTitle>
    <Authors>Imamul Kadir</Authors>
    <Description>Fyltrix: A tabbed file explorer with real previews for PDF, HTML, Markdown, JSON, Word, Excel, CSV, images and code. Runs without admin rights.</Description>
    <Version>0.1.3</Version>
    <FileVersion>0.1.3.0</FileVersion>
    <AssemblyVersion>0.1.3.0</AssemblyVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fyltrix.Updates\Fyltrix.Updates.csproj" />
    <Content Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <!-- MIT. Reads ZIP/7z/RAR/TAR/GZ/BZ2/XZ; writing uses the .NET built-ins. -->
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <!-- MIT. Only used to write WebP (WIC has no WebP encoder); loaded on first use. -->
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <!-- MIT. PDF merge/split/extract/reorder/rotate and metadata. -->
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <!-- MIT. QR codes for local share links. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fyltrix.Tests" />
    <InternalsVisibleTo Include="Fyltrix.PlacementProbe" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms is only used to host Windows preview handlers (ShellPreviewHost).
         Drop its implicit global usings so WPF/WinForms names (Application, MessageBox...) don't clash. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <!-- WPF projects drop System.IO from implicit usings; add it back -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The preview viewer (HTML/JS + libraries) is embedded in the exe and served to WebView2 in-process. -->
    <EmbeddedResource Include="Viewer\**\*" LogicalName="Viewer/%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Minimal, schema-valid Office documents for the New menu (regenerate with tools/OfficeTemplates). -->
    <EmbeddedResource Include="Templates\*" LogicalName="Templates/%(Filename)%(Extension)" />
    <!-- Window and notification-area icon. -->
    <EmbeddedResource Include="Assets\Fyltrix.ico" LogicalName="Assets/Fyltrix.ico" />
  </ItemGroup>

</Project>

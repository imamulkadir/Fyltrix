<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationIcon>..\Fyltrix\Assets\Fyltrix.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <Product>Fyltrix</Product>
    <Company>Fyltrix</Company>
    <Title>Fyltrix launcher</Title>
    <Description>Launches the selected Fyltrix release payload.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ReleaseLayout.cs;UpdateProtocol.cs;TrialConnection.cs" />
    <ProjectReference Include="..\Fyltrix.Bootstrap\Fyltrix.Bootstrap.csproj" />
  </ItemGroup>
</Project>

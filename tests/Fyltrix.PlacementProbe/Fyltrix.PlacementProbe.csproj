<Project Sdk="Microsoft.NET.Sdk">

  <!-- Test helper started by Fyltrix.Tests (MonitorPlacementTests). Per-monitor DPI aware through Fyltrix' own manifest,
       which the test host can't be, so window positions and DPI on a second monitor are exactly what Fyltrix gets. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <IsPackable>false</IsPackable>
    <ApplicationManifest>..\..\src\Fyltrix\app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Fyltrix\Fyltrix.csproj" />
    <ProjectReference Include="..\..\src\Fyltrix.Updates\Fyltrix.Updates.csproj" />
  </ItemGroup>

</Project>
